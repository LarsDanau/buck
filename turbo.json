{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["config", "domain", "db"]
        }
      },
      "domain": {
        "dependencies": {
          "deny": ["app", "db"]
        }
      },
      "db": {
        "dependencies": {
          "allow": ["config", "domain"]
        }
      }
    }
  },
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {},
    "format:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:ci": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
