    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "check-types": "tsc --noEmit",
    "test": "jest --config ./jest.config.ts",
    "test:watch": "jest --config ./jest.config.ts --watch",
    "test:ci": "jest --config ./jest.config.ts --runInBand --ci --watchman=false",
    "doctor": "bunx expo-doctor",
    "config:check": "APP_ENV=ci expo config --type public"
  },
  "dependencies": {
