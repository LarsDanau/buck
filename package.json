{
  "name": "buck",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.3.6",
      "typescript": "^5.9.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "check": "oxlint && oxfmt",
    "check:fix": "oxlint --fix && oxfmt --write",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:fix": "oxfmt --write"
  },
  "dependencies": {
    "@buck/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@buck/config": "workspace:*",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "turbo": "^2.8.20",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.5"
}
